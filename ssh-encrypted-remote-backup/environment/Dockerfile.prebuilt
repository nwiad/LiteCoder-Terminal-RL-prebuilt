# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: ssh-encrypted-remote-backup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# --- Task-specific setup ---

# Install task-required tools: openssh, openssl, cron
RUN apt-get update && apt-get install -y \
    openssh-client openssl cron \
    && rm -rf /var/lib/apt/lists/*

# Create the working directory and the source directory to be backed up
RUN mkdir -p /app /srv/apps

# Copy sample application files into /srv/apps
COPY test_data/srv_apps/ /srv/apps/

WORKDIR /app
