# Source task: crack-flawed-encryption-vault
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Task-specific setup
WORKDIR /app

# Copy task files
COPY encryption_program.py /app/encryption_program.py
COPY README.md /app/README.md
COPY generate_vault.py /tmp/generate_vault.py

# Install pycryptodome and generate the encrypted vault
RUN . /opt/openhands-venv/bin/activate && \
    uv pip install pycryptodome && \
    python /tmp/generate_vault.py && \
    rm /tmp/generate_vault.py
