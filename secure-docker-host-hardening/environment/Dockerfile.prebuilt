# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: secure-docker-host-hardening
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install packages needed for the hardening task
RUN apt-get update && apt-get install -y \
    openssh-server \
    ufw \
    docker.io \
    fail2ban \
    rsyslog \
    && rm -rf /var/lib/apt/lists/*

# Ensure standard directories and default config files exist
RUN mkdir -p /etc/docker && \
    mkdir -p /etc/fail2ban && \
    mkdir -p /etc/sysctl.d && \
    mkdir -p /etc/rsyslog.d && \
    mkdir -p /var/log

# Set working directory
WORKDIR /

# Copy the default sshd_config as a baseline (unhardened)
COPY sshd_config /etc/ssh/sshd_config
