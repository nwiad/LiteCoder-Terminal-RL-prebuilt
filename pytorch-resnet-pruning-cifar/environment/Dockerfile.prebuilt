# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: pytorch-resnet-pruning-cifar
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install PyTorch (CPU), torchvision, matplotlib into the OpenHands venv
RUN . /opt/openhands-venv/bin/activate && \
    uv pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install matplotlib

# Set working directory
WORKDIR /app

# Create output directory
RUN mkdir -p /app/output
