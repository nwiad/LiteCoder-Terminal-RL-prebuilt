# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: docker-lemp-stack-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install Docker CLI and Docker-in-Docker dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    gnupg \
    lsb-release \
    iptables \
    supervisor \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin \
    && rm -rf /var/lib/apt/lists/*

# Pre-pull the Docker images needed for the LEMP stack to save time
# (These will be available when dockerd starts inside the container)
# Note: Cannot pre-pull here since dockerd isn't running during build.
# The agent will pull them at runtime.

# Set working directory to /app as specified in instruction.md
WORKDIR /app
