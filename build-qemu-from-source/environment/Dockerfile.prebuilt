# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: build-qemu-from-source
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install QEMU build dependencies from system packages only
RUN apt-get update && apt-get install -y \
    ninja-build \
    pkg-config \
    libglib2.0-dev \
    libpixman-1-dev \
    libslirp-dev \
    libfdt-dev \
    zlib1g-dev \
    python3 \
    python3-venv \
    sudo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
