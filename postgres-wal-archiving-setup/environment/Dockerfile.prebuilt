# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: postgres-wal-archiving-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install PostgreSQL and required system packages
RUN apt-get update && apt-get install -y \
    postgresql postgresql-client \
    openssh-server openssh-client \
    cron sudo \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app
