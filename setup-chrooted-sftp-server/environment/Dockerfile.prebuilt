# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: setup-chrooted-sftp-server
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Task-specific setup: SFTP server with chrooted users
# Install openssh-server and rsyslog for sshd and logging
RUN apt-get update && apt-get install -y \
    openssh-server \
    rsyslog \
    && rm -rf /var/lib/apt/lists/*

# Ensure required directories exist
RUN mkdir -p /run/sshd /sftp /app

# Generate SSH host keys
RUN ssh-keygen -A

WORKDIR /app
