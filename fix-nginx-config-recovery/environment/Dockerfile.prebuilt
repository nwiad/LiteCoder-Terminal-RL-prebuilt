# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: fix-nginx-config-recovery
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install Nginx and required utilities for the task
RUN apt-get update && apt-get install -y \
    nginx \
    procps \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy setup script
COPY setup.sh /app/setup.sh
RUN chmod +x /app/setup.sh
