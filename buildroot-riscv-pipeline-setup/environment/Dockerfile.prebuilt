# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: buildroot-riscv-pipeline-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Ensure disk-image utilities are available (e2fsprogs for mkfs.ext2, fdisk for sfdisk)
# These are typically present in ubuntu:24.04 but ensure they exist
RUN apt-get update && apt-get install -y \
    e2fsprogs fdisk \
    && rm -rf /var/lib/apt/lists/*

# Set working directory as specified in instruction.md
WORKDIR /app
