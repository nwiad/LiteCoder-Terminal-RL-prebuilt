# Source task: nginx-static-reverse-proxy
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install task-specific packages: nginx, ufw, openssl, nodejs (apt version), logrotate
RUN apt-get update && apt-get install -y \
    nginx \
    ufw \
    openssl \
    nodejs \
    logrotate \
    systemctl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
