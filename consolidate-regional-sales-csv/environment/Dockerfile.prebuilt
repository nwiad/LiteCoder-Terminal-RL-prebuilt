# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: consolidate-regional-sales-csv
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Set working directory
WORKDIR /app

# Create required directories
RUN mkdir -p /app/input /app/output

# Copy input CSV files
COPY input/north_america.csv /app/input/north_america.csv
COPY input/europe.csv /app/input/europe.csv
COPY input/asia_pacific.csv /app/input/asia_pacific.csv
COPY input/latin_america.csv /app/input/latin_america.csv
COPY input/africa.csv /app/input/africa.csv

# Copy test data for edge case testing
COPY test_data/ /app/test_data/
