FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install Nginx
RUN apt-get update && apt-get install -y nginx && rm -rf /var/lib/apt/lists/*

# Create required directories
RUN mkdir -p /app /var/cache/nginx/site_cache

WORKDIR /app
