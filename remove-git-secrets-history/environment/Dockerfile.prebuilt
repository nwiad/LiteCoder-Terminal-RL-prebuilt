FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install git-filter-repo
RUN apt-get update && apt-get install -y git-filter-repo && rm -rf /var/lib/apt/lists/*

# Set working directory
