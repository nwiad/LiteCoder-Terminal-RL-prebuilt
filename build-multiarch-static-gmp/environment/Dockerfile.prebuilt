# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: build-multiarch-static-gmp
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install cross-compilation toolchain for aarch64 and other build dependencies
RUN apt-get update && apt-get install -y \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu \
    m4 \
    xz-utils \
    file \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
