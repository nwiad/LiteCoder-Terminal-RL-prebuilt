# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: shell-injection-audit-harden
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# --- Task-specific setup ---

# Create working directory
RUN mkdir -p /app
WORKDIR /app

# Create the ctf unprivileged user
RUN useradd -m -s /bin/bash ctf

# Place the flag file (readable only by root)
COPY flag.txt /root/flag.txt
RUN chmod 600 /root/flag.txt

# Create /srv/secure/ directory with legitimate files
RUN mkdir -p /srv/secure
COPY secure_data.txt /srv/secure/data.txt
COPY secure_notes.txt /srv/secure/notes.txt
RUN chmod 755 /srv/secure && chmod 644 /srv/secure/*

# Place the vulnerable C source at /tmp/vuln-wrapper.c
COPY vuln-wrapper.c /tmp/vuln-wrapper.c
RUN chmod 644 /tmp/vuln-wrapper.c

# Create /opt directory for the binary (will be compiled by the agent)
RUN mkdir -p /opt
