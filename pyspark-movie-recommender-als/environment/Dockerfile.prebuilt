FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Set working directory
WORKDIR /app

# Create required directories
RUN mkdir -p /app/ml-1m /app/output

# Copy MovieLens 1M sample data files
COPY ratings.dat /app/ml-1m/ratings.dat
