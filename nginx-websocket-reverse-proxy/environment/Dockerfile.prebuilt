FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Task-specific packages originally embedded in the common apt block.
RUN apt-get update && apt-get install -y \
    nginx \
    && rm -rf /var/lib/apt/lists/*

# Ensure NGINX directories exist
RUN mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled /var/log/nginx

WORKDIR /app
