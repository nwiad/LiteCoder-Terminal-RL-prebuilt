FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Set working directory
WORKDIR /app

# Create required directories
RUN mkdir -p /app/data /app/model

# Copy dataset files
COPY data/train.csv /app/data/train.csv
COPY data/test.csv /app/data/test.csv

# Copy prediction input file
COPY input.json /app/input.json

# Copy additional test data
COPY test_data/ /app/test_data/
