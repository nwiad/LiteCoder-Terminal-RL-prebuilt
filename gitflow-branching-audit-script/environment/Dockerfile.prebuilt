# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: gitflow-branching-audit-script
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Task-specific packages originally embedded in the common apt block.
RUN apt-get update && apt-get install -y \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy setup script and make it executable
COPY setup_repo.sh /app/setup_repo.sh
RUN chmod +x /app/setup_repo.sh

# Configure git defaults for the setup script
RUN git config --global init.defaultBranch master

# Run setup script to create the test repository
RUN /app/setup_repo.sh
