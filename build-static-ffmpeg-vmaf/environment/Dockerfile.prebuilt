# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: build-static-ffmpeg-vmaf
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install build dependencies needed for compiling FFmpeg and its libraries from source
RUN apt-get update && apt-get install -y \
    autoconf automake libtool pkg-config \
    cmake meson ninja-build nasm yasm \
    texinfo zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
