# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: secure-ssh-key-auth-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install OpenSSH server for the SSH configuration task
RUN apt-get update && apt-get install -y \
    openssh-server \
    && rm -rf /var/lib/apt/lists/*

# Generate SSH host keys so sshd -t validation works
RUN ssh-keygen -A

# Copy the default sshd_config to its expected location
COPY sshd_config /etc/ssh/sshd_config

# Create the required working directory
RUN mkdir -p /app

WORKDIR /app
