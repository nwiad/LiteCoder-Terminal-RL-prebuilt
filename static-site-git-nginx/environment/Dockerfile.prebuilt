# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: static-site-git-nginx
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install task-specific packages: nginx and pandoc
RUN apt-get update && apt-get install -y \
    nginx \
    pandoc \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Create required directories
RUN mkdir -p /app/site-output

# Copy test data for verification
COPY test_data/ /app/test_data/
