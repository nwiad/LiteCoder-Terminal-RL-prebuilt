# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: train-sentiment-classifier
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Set working directory
WORKDIR /app

# Download the real Amazon reviews dataset
RUN wget -O /app/amazon.csv "https://raw.githubusercontent.com/pycaret/pycaret/master/datasets/amazon.csv"

# Copy the sample dataset as a fallback in case download fails
COPY amazon.csv /app/amazon_sample.csv
