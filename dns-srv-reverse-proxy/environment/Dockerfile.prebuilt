# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: dns-srv-reverse-proxy
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install dnsmasq for DNS service discovery
RUN apt-get update && apt-get install -y dnsmasq && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy dnsmasq configuration
COPY dnsmasq.conf /app/dnsmasq.conf
