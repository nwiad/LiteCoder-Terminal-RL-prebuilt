# Source task: nyc-taxi-ml-pipeline
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Set working directory
WORKDIR /app

# Copy and run data generation script to create the Parquet input file
COPY generate_data.py /tmp/generate_data.py
RUN . /opt/openhands-venv/bin/activate && \
    uv pip install pandas pyarrow numpy && \
    python /tmp/generate_data.py && \
    rm /tmp/generate_data.py
