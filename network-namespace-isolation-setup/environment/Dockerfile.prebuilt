# Source task: network-namespace-isolation-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install networking tools required for the task
RUN apt-get update && apt-get install -y \
    iproute2 \
    iptables \
    tcpdump \
    iputils-ping \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app
