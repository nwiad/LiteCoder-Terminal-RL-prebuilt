# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: gpg-key-compromise-recovery
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install GPG (required for the task)
RUN apt-get update && apt-get install -y \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy setup script and run it to bootstrap the GPG environment
COPY setup.sh /app/setup.sh
RUN chmod +x /app/setup.sh && /app/setup.sh
