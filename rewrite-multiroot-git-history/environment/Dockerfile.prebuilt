# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: rewrite-multiroot-git-history
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Task-specific packages originally embedded in the common apt block.
RUN apt-get update && apt-get install -y \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /app

# Configure git globally
RUN git config --global user.name "Setup Script" && \
    git config --global user.email "setup@example.com" && \
    git config --global init.defaultBranch main

# Copy and run the repository setup script
COPY setup_repo.sh /app/setup_repo.sh
RUN chmod +x /app/setup_repo.sh && bash /app/setup_repo.sh && rm /app/setup_repo.sh
