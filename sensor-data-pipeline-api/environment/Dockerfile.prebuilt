FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Set working directory as specified in instruction.md
WORKDIR /app

# Create data directories
RUN mkdir -p /data/raw /app/data/cleaned /app/data/analytics /app/pipeline

# Copy test data generator and generate test data
COPY generate_test_data.py /tmp/generate_test_data.py
RUN python3 /tmp/generate_test_data.py && rm /tmp/generate_test_data.py
