# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: ssh-jump-host-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install SSH server and rsyslog for the jump host task
RUN apt-get update && apt-get install -y \
    openssh-server openssh-client \
    rsyslog \
    && rm -rf /var/lib/apt/lists/*

# Prepare SSH host keys and required directories
RUN mkdir -p /run/sshd

# Set working directory
WORKDIR /app
