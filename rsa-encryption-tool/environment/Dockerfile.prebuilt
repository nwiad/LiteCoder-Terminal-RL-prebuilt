# Source task: rsa-encryption-tool
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install OpenSSL development libraries for the task
RUN apt-get update && apt-get install -y \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy test data files
COPY test_input.txt /app/test_input.txt
COPY test_binary.dat /app/test_binary.dat
