# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: harden-ssh-audit-config
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# ---- Task-specific setup ----

# Install OpenSSH server and cron (needed for the task)
RUN apt-get update && apt-get install -y \
    openssh-server \
    cron \
    mailutils \
    && rm -rf /var/lib/apt/lists/*

# Generate SSH host keys
RUN ssh-keygen -A

# Copy the default (unhardened) sshd_config into place
COPY sshd_config /etc/ssh/sshd_config

# Ensure the sshd run directory exists
RUN mkdir -p /run/sshd

# Create working directory
RUN mkdir -p /app

WORKDIR /app
