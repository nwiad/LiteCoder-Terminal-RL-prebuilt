FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install openssh-server for SSH key-based operations
RUN apt-get update && apt-get install -y \
    openssh-server \
    && rm -rf /var/lib/apt/lists/*

