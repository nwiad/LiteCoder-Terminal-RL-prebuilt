# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: local-dns-docker-nginx
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install BIND9 and Docker dependencies
RUN apt-get update && apt-get install -y \
    bind9 bind9utils bind9-doc dnsutils \
    docker.io nginx \
    systemctl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the index.html that the Nginx container should serve
COPY index.html /app/index.html
