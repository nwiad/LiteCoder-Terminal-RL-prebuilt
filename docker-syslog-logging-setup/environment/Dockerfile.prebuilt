# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: docker-syslog-logging-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install Docker, rsyslog, and logrotate for the logging configuration task
RUN apt-get update && apt-get install -y \
    docker.io \
    rsyslog \
    logrotate \
    systemd \
    sudo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
