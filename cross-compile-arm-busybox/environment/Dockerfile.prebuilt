# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: cross-compile-arm-busybox
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Task-specific: install ARM cross-compiler (musl-based) and QEMU user-mode emulation
RUN apt-get update && apt-get install -y \
    musl-tools \
    qemu-user-static \
    gcc-arm-linux-gnueabihf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create the output directory
RUN mkdir -p /app/output
