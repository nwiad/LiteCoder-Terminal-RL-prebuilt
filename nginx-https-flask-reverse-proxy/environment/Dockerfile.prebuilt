# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: nginx-https-flask-reverse-proxy
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install Nginx and OpenSSL for the reverse proxy task
RUN apt-get update && apt-get install -y \
    nginx \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Create required directories
RUN mkdir -p /etc/nginx/ssl /app

WORKDIR /app
