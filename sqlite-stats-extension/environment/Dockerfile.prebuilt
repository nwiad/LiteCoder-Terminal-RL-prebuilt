# Source task: sqlite-stats-extension
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install SQLite3 and development headers needed for the extension
RUN apt-get update && apt-get install -y \
    sqlite3 libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
