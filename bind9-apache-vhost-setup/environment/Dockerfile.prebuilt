# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: bind9-apache-vhost-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install BIND9, Apache2, iptables, and DNS utilities
RUN apt-get update && apt-get install -y \
    bind9 \
    bind9utils \
    bind9-dnsutils \
    apache2 \
    iptables \
    systemctl \
    && rm -rf /var/lib/apt/lists/*

# Create required directories
RUN mkdir -p /var/log/named && \
    chown bind:bind /var/log/named && \
    mkdir -p /var/www/company.com && \
    mkdir -p /var/www/portal.company.com && \
    mkdir -p /var/www/api.company.com && \
    mkdir -p /app

WORKDIR /app
