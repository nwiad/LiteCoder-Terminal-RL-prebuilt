# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: nginx-ssl-load-balancer
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install Nginx and OpenSSL for the load balancer task
RUN apt-get update && apt-get install -y \
    nginx \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Set up working directory structure
WORKDIR /app
RUN mkdir -p /app/ssl /app/nginx
