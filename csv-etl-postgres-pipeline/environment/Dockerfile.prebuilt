# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: csv-etl-postgres-pipeline
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install PostgreSQL
RUN apt-get update && apt-get install -y \
    postgresql postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy data files
COPY data/products.csv /app/data/products.csv
COPY data/customers.csv /app/data/customers.csv
COPY data/orders.csv /app/data/orders.csv
COPY data/order_items.csv /app/data/order_items.csv
