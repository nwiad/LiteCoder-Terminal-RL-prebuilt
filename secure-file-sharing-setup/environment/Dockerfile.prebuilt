# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: secure-file-sharing-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Pre-install packages needed for the task so they are available offline/cached
RUN apt-get update && apt-get install -y \
    openssh-server \
    auditd \
    fail2ban \
    rsync \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Create the working directory for output
RUN mkdir -p /app

WORKDIR /app
