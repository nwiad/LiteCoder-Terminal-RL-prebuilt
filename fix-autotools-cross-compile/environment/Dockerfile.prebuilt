# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: fix-autotools-cross-compile
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install autotools and ARM cross-compilation toolchain
RUN apt-get update && apt-get install -y \
    autoconf automake libtool \
    gcc-arm-linux-gnueabihf \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy setup script
COPY setup.py /app/setup.py
