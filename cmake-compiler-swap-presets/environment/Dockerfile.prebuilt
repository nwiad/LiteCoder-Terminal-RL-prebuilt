# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: cmake-compiler-swap-presets
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install GCC, Clang, CMake, and build tools required for the task
RUN apt-get update && apt-get install -y \
    gcc g++ \
    clang \
    cmake \
    make \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Set working directory as specified in instruction.md
WORKDIR /app
