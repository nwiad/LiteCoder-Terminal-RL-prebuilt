# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: tune-postgresql-performance
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install PostgreSQL, pgBouncer, and pgbench
RUN apt-get update && apt-get install -y \
    postgresql \
    postgresql-contrib \
    pgbouncer \
    sudo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
