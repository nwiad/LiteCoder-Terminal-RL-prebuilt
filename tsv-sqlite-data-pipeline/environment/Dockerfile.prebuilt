# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: tsv-sqlite-data-pipeline
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install sqlite3 for the pipeline
RUN apt-get update && apt-get install -y sqlite3 && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Create required directory structure
RUN mkdir -p raw clean sql log out

# Copy raw TSV input files
COPY partner_a.tsv /app/raw/partner_a.tsv
COPY partner_b.tsv /app/raw/partner_b.tsv
COPY partner_c.tsv /app/raw/partner_c.tsv
