# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: harden-ssh-2fa-key-auth
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install SSH server, PAM modules, and Google Authenticator for the task
RUN apt-get update && apt-get install -y \
    openssh-server \
    libpam-google-authenticator \
    passwd \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Ensure SSH host keys are generated and sshd run directory exists
RUN mkdir -p /run/sshd && \
    ssh-keygen -A

# Set working directory to /app as required by instruction.md
WORKDIR /app
