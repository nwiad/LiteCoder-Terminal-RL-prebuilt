# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: multi-repo-git-ci-simulator
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install GPG for signed tags and commits
RUN apt-get update && apt-get install -y \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Configure git defaults for non-interactive use
RUN git config --global user.email "dev@minicorp.local" && \
    git config --global user.name "MiniCorp Dev" && \
    git config --global init.defaultBranch main

# Set working directory as specified in instruction.md
WORKDIR /app
