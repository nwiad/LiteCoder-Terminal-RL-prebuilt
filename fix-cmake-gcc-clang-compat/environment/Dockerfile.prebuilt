# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: fix-cmake-gcc-clang-compat
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install CMake, GCC, Clang for the build task
RUN apt-get update && apt-get install -y \
    cmake gcc g++ clang \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy project files
COPY CMakeLists.txt /app/CMakeLists.txt
COPY include/ /app/include/
COPY src/ /app/src/
