# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: nginx-ssl-reverse-proxy-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install Nginx and OpenSSL for the reverse proxy + SSL task
RUN apt-get update && apt-get install -y \
    nginx \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Prepare directory structure required by the task
RUN mkdir -p /app/backends /etc/nginx/ssl /etc/nginx/sites-available /etc/nginx/sites-enabled

WORKDIR /app
