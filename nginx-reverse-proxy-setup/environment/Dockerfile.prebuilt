# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: nginx-reverse-proxy-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install Nginx and OpenSSL for the task
RUN apt-get update && apt-get install -y \
    nginx \
    openssl \
    jq \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Create required directories
RUN mkdir -p /etc/nginx/ssl /etc/nginx/sites-available /etc/nginx/sites-enabled /var/log/nginx /app

WORKDIR /app
