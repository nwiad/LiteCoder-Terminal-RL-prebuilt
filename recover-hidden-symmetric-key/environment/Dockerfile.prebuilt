# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: recover-hidden-symmetric-key
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install steghide, openssl, and imagemagick for test data generation
RUN apt-get update && apt-get install -y \
    steghide openssl imagemagick \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and run the setup script to generate test data
COPY setup_data.sh /tmp/setup_data.sh
RUN chmod +x /tmp/setup_data.sh && /tmp/setup_data.sh && rm /tmp/setup_data.sh
