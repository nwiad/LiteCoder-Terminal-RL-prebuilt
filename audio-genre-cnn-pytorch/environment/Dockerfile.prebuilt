# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: audio-genre-cnn-pytorch
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Task-specific packages originally embedded in the common apt block.
RUN apt-get update && apt-get install -y \
    libsndfile1 \
    libsox-dev \
    sox \
    && rm -rf /var/lib/apt/lists/*

# Install task-specific Python packages: PyTorch CPU, torchaudio, tensorboard
RUN . /opt/openhands-venv/bin/activate && \
    uv pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install tensorboard

WORKDIR /app
