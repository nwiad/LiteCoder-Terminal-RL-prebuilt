# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: dns-server-flask-dashboard
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install dnsmasq for the DNS server task
RUN apt-get update && apt-get install -y \
    dnsmasq systemctl \
    && rm -rf /var/lib/apt/lists/*

# Create dnsmasq custom config directory
RUN mkdir -p /etc/dnsmasq.d

# Set up the application directory
WORKDIR /app
RUN mkdir -p /app/dns_dashboard

# Copy seed mappings data
COPY mappings.json /app/dns_dashboard/mappings.json
