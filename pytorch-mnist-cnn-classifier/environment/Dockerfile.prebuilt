# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: pytorch-mnist-cnn-classifier
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Set working directory
WORKDIR /app

# Pre-create the data directory for MNIST downloads
RUN mkdir -p /app/data

# Install task-specific Python libraries into the OpenHands venv
RUN . /opt/openhands-venv/bin/activate && \
    uv pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install matplotlib seaborn scikit-learn
