# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: arm64-cross-compile-setup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install cross-compilation toolchain for ARM64
RUN apt-get update && apt-get install -y \
    gcc-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu \
    file \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Set up working directory as specified in instruction.md
WORKDIR /app
