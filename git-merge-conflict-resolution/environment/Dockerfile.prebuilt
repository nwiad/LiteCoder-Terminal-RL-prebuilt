FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Set up working directory
WORKDIR /app/repo

# Copy initial data files to a staging area (not into the repo itself)
COPY app.js /app/seed/app.js
COPY config.json /app/seed/config.json

# Configure Git default user
RUN git config --global user.name "Developer" && \
    git config --global user.email "dev@example.com"
