# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: docker-multilang-sdk-build
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install task-specific build dependencies: gcc (via build-essential above),
# make (via build-essential above), JDK for javac, python3 for the Python package,
# and zip for creating .whl archives
RUN apt-get update && apt-get install -y \
    default-jdk \
    python3 \
    python3-pip \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Set working directory to /app as required by instruction.md
WORKDIR /app
