FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Configure git for committing inside the container
RUN git config --global user.email "test@example.com" && \
    git config --global user.name "Test User" && \
    git config --global init.defaultBranch main

# Set working directory as specified in instruction.md
WORKDIR /app

# Create the repo directory
RUN mkdir -p /app/repo
