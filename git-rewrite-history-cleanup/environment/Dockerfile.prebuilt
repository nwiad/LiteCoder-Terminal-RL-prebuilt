# Source task: git-rewrite-history-cleanup
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Task-specific setup
WORKDIR /app

# Copy and run the setup script
COPY setup_repo.sh /app/setup_repo.sh
RUN chmod +x /app/setup_repo.sh

# Configure git globally (needed for the setup script)
RUN git config --global user.email "dev@example.com" && \
    git config --global user.name "Developer" && \
    git config --global init.defaultBranch main

# Run the setup script to create the messy repo
RUN /app/setup_repo.sh
