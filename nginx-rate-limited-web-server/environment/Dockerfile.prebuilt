# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: nginx-rate-limited-web-server
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Set working directory
WORKDIR /app

# Create required directory structure for Nginx content
RUN mkdir -p /var/www/api /var/www/admin /var/log/nginx

# Copy HTML files to their required locations
COPY api_index.html /var/www/api/index.html
COPY admin_index.html /var/www/admin/index.html
