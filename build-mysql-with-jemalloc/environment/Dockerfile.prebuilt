# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: build-mysql-with-jemalloc
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install MySQL build dependencies
RUN apt-get update && apt-get install -y \
    cmake \
    gcc \
    g++ \
    make \
    libssl-dev \
    libncurses5-dev \
    libtirpc-dev \
    pkg-config \
    bison \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Create necessary directories
RUN mkdir -p /app/mysql /app/jemalloc
