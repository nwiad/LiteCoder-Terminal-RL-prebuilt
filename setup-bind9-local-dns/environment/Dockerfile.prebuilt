# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: setup-bind9-local-dns
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install BIND9 and DNS utilities needed for the task
RUN apt-get update && apt-get install -y \
    bind9 \
    bind9utils \
    bind9-doc \
    dnsutils \
    && rm -rf /var/lib/apt/lists/*

# Create required directories
RUN mkdir -p /var/log/named && \
    chown bind:bind /var/log/named

WORKDIR /app
