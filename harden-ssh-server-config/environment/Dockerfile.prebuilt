# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: harden-ssh-server-config
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install openssh-server and ufw for the SSH hardening task
RUN apt-get update && apt-get install -y \
    openssh-server ufw \
    && rm -rf /var/lib/apt/lists/*

# Set up SSH host keys so sshd can start
RUN ssh-keygen -A

# Ensure the privilege separation directory exists
RUN mkdir -p /run/sshd

# Place the default sshd_config (Ubuntu-style defaults)
COPY sshd_config /etc/ssh/sshd_config

# Create working directory
RUN mkdir -p /app
WORKDIR /app
