FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Download the LLVM 17.0.6 source tarball to /root/
RUN wget -q -O /root/llvm-project-17.0.6.src.tar.xz \
    https://github.com/llvm/llvm-project/releases/download/llvmorg-17.0.6/llvm-project-17.0.6.src.tar.xz

# Set up working directory
WORKDIR /app

# Copy demo pass source files
COPY demo_pass/ /app/demo_pass/
