# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: nginx-multi-vhost-node-proxy
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install Nginx and OpenSSL for TLS cert generation
RUN apt-get update && apt-get install -y \
    nginx openssl systemctl \
    && rm -rf /var/lib/apt/lists/*

# Create required directory structure
RUN mkdir -p /app/services/svc-a \
             /app/services/svc-b \
             /app/services/svc-c \
             /etc/ssl/test \
             /etc/nginx/sites-enabled

WORKDIR /app
