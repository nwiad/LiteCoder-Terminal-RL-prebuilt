# Source task: cmake-static-lib-migration
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install CMake, pkg-config, and required development libraries
RUN apt-get update && apt-get install -y \
    cmake \
    pkg-config \
    libpng-dev \
    zlib1g-dev \
    libjpeg-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
