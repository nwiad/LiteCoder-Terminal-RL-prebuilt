# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: build-debian-package-repo
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install Debian package building tools
RUN apt-get update && apt-get install -y \
    dpkg-dev \
    debhelper \
    devscripts \
    apt-utils \
    fakeroot \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy test data files
COPY custom.patch /app/custom.patch
COPY branding.conf /app/branding.conf
