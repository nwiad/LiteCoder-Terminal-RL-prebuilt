# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: deploy-fim-c-binary
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Create required directory structure
RUN mkdir -p /var/www/html \
    && mkdir -p /var/log/fim \
    && mkdir -p /root/.fim

# Copy web content files into the monitored web-root
COPY index.html /var/www/html/index.html
COPY about.html /var/www/html/about.html
COPY style.css /var/www/html/style.css
COPY test_data/robots.txt /var/www/html/robots.txt
COPY test_data/contact.html /var/www/html/contact.html

WORKDIR /root
