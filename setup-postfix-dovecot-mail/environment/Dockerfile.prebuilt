# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: setup-postfix-dovecot-mail
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Set working directory
WORKDIR /app

# Create necessary directories
RUN mkdir -p /etc/ssl/certs /etc/ssl/private

# Copy SSL certificates
COPY mail-server.crt /etc/ssl/certs/mail-server.crt
COPY mail-server.key /etc/ssl/private/mail-server.key

# Set proper permissions for SSL key
RUN chmod 600 /etc/ssl/private/mail-server.key
