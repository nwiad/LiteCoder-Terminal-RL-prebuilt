# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: nginx-consul-service-discovery
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install Nginx
RUN apt-get update && apt-get install -y \
    nginx \
    jq \
    dnsutils \
    && rm -rf /var/lib/apt/lists/*

# Install Consul
RUN ARCH=$(dpkg --print-architecture) && \
    wget -q https://releases.hashicorp.com/consul/1.20.1/consul_1.20.1_linux_${ARCH}.zip -O /tmp/consul.zip && \
    apt-get update && apt-get install -y unzip && rm -rf /var/lib/apt/lists/* && \
    unzip /tmp/consul.zip -d /usr/local/bin/ && \
    rm /tmp/consul.zip && \
    chmod +x /usr/local/bin/consul

WORKDIR /app
