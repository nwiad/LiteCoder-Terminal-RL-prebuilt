# Generated by skill-master/docker/litecoder_terminal_opencode/generate_prebuilt_dockerfiles.py
# Source task: dnsmasq-local-reverse-proxy
FROM hub.byted.org/dwn_open_docker/litecoder-terminal-base.opencode:1.15.4

# Install dnsmasq
RUN apt-get update && apt-get install -y \
    dnsmasq \
    && rm -rf /var/lib/apt/lists/*

# Create dnsmasq config directory
RUN mkdir -p /etc/dnsmasq.d

# Set working directory
WORKDIR /app

# Copy initial domains.json
COPY domains.json /app/domains.json
